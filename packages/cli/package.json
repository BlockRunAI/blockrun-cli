{
  "name": "@blockrun/cli",
  "version": "0.2.1",
  "description": "One CLI for BlockRun account API keys or x402 payments on Solana and Base.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockRunAI/blockrun-cli.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "blockrun",
    "x402",
    "cli",
    "llm",
    "ai",
    "usdc",
    "wallet",
    "agent",
    "micropayments"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "blockrun": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blockrun/core": "workspace:^",
    "@blockrun/llm": "^3.10.0"
  }
}
